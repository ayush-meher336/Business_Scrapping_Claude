# Copy to .env and fill in. Never commit .env.

# Google Sheets sync, option 1 (recommended): the Apps Script web app from apps_script/Code.gs.
# Paste the script into the spreadsheet (Extensions > Apps Script), deploy as a web app
# (Execute as: Me, Who has access: Anyone) and put its /exec URL here. Keep the URL private.
SHEETS_WEBAPP_URL=

# Option 2: a service account (used only when SHEETS_WEBAPP_URL is empty).
GOOGLE_SERVICE_ACCOUNT_JSON=secrets/service-account.json
GOOGLE_SHEET_ID=
